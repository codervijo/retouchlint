---
// Served with a real 404 status by wrangler's `not_found_handling: "404-page"`.
// The old single-page-application fallback returned the homepage with a 200
// for every unknown URL, which Google reads as soft-404s.
import Layout from "../layouts/Layout.astro";
---
<Layout noindex title="Page not found — RetouchLint" description="This page does not exist.">
  <main class="container-page py-24 text-center">
    <h1 class="font-display text-4xl text-foreground">Page not found</h1>
    <p class="mt-4 text-muted-foreground">That URL doesn't exist on retouchlint.com.</p>
    <nav class="mt-8 flex flex-wrap justify-center gap-5 text-sm">
      <a href="/" class="text-primary underline underline-offset-4">Home</a>
      <a href="/real-estate-photo-disclosure/" class="text-primary underline underline-offset-4">Disclosure guide</a>
      <a href="/blog/" class="text-primary underline underline-offset-4">Articles</a>
      <a href="/faq/" class="text-primary underline underline-offset-4">FAQ</a>
    </nav>
  </main>
</Layout>
