---
// src/pages/index.astro
// Standalone head (keeps the technical-SEO baseline tags inline so the
// SEO regression test can assert against this file directly).
import "../styles/styles.css";
import Island from "@/components/Island";

const site = "https://retouchlint.com";
const title = "RetouchLint — Disclosure-ready listing photos";
const description = "RetouchLint helps agents and photographers document original photos, edited finals, and required disclosures in one clean audit packet — no AI detection guesswork, just a paper trail you can hand to a broker or buyer.";

const themeScript = `
  (function() {
    try {
      const theme = localStorage.getItem('retouchlint-theme') || 'system';
      const resolved = theme === 'system'
        ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : theme;
      document.documentElement.classList.add(resolved);
    } catch (e) {}
  })();
`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="RetouchLint" />
    <link rel="canonical" href={site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:site_name" content="retouchlint.com" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@RetouchLint" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
    />

    <!-- JSON-LD structured data: Organization + WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://retouchlint.com/#organization",
          "name": "RetouchLint",
          "url": "https://retouchlint.com/"
        },
        {
          "@type": "WebSite",
          "@id": "https://retouchlint.com/#website",
          "url": "https://retouchlint.com/",
          "name": "RetouchLint",
          "publisher": { "@id": "https://retouchlint.com/#organization" }
        }
      ]
    })} />

    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <Island page="landing" client:load />
  </body>
</html>
