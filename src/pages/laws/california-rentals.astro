    })),
  },
];

const related = [
  { url: "/laws/", anchor: "All listing photo disclosure laws and bills" },
  { url: "/blog/california-real-estate-photo-disclosure/", anchor: "AB 723, the sales version" },
  { url: "/virtually-staged-meaning/", anchor: "What \"virtually staged\" means for renters" },
