---
// /laws/california-rentals/ — AB 2025 → Civil Code § 1940.11 (rentals), effective 2027-01-01.
// Source quotes: docs/law-sources.md § AB 2025.
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const path = "/laws/california-rentals/";
const SOURCE = "https://leginfo.legislature.ca.gov/faces/billTextClient.xhtml?bill_id=202520260AB2025";
const title = "California AB 2025: Altered Rental Listing Photos (2027)";
const h1 = "California's rental listing photo law (AB 2025): what changes January 1, 2027";
const description =
  "From 2027, anyone advertising a California rental must label altered or AI-generated photos and show the original. Who's covered and what to post.";

const faq = [
  {
    q: "When does AB 2025 take effect?",
    a: "January 1, 2027. The Governor signed it on September 27, 2026 (Chapter 572, Statutes of 2026), and as a non-urgency statute it takes effect on the first of the following year.",
  },
  {
    q: "Does it apply to landlords who aren't real estate agents?",
    a: "The new Civil Code § 1940.11 applies to \"a person who includes a digitally altered image in an advertisement or other promotional material for rental of real property\" — not only to licensees. A licensee who violates it is also treated as violating their licensing law.",
  },
  {
    q: "Do AI-generated apartment photos need a disclosure?",
    a: "Yes. The rental law's definition of a digitally altered image includes an image \"fully generated through artificial intelligence software\". Such an image needs the disclosure, but because it wasn't taken with a capture device, the requirement to include an original doesn't apply.",
  },
  {
    q: "What about leases longer than a year?",
    a: "From 2027 they fall under the rental rule. AB 2025 adds a subsection to the sales law, § 10140.8, saying it no longer applies to advertising for a leasehold exceeding one year.",
  },
  {
    q: "Is color correction or brightening covered?",
    a: "No. Like the sales law, § 1940.11 excludes images where only lighting, sharpening, white balance, color correction, angle, straightening, cropping, exposure or similar adjustments were made that don't change the representation of the property.",
  },
];

const schema = [
  {
    "@type": "Article",
    headline: h1,
    description,
    mainEntityOfPage: `https://retouchlint.com${path}`,
    author: { "@type": "Organization", name: "RetouchLint" },
    publisher: { "@id": "https://retouchlint.com/#organization" },
  },
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
