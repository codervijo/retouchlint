---
// /mls-photo-requirements/crmls/ — CRMLS Rule 11.5.2 (Rules & Policies effective 2026-07-10).
// Source quotes: docs/mls-sources.md § CRMLS (primary-source check 2026-11-08).
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const path = "/mls-photo-requirements/crmls/";
const SOURCE = "https://go.crmls.org/crmls-rules-and-policies/";
const title = "CRMLS Rule 11.5.2: Digitally Altered Listing Photos";
const h1 = "CRMLS Rule 11.5.2: which photo edits CRMLS allows, labels, and bans";
const description =
  "CRMLS lets you virtually stage with a label and the original beside it, but bans edits to landscape, walls or power lines. The July 2026 rule explained.";

const faq = [
  {
    q: "Is virtual staging allowed on CRMLS?",
    a: "Yes. Virtual staging is the edit Rule 11.5.2 is built around: CRMLS defines a Digitally Altered Image as one altered to add, remove, or change elements related to furniture or appliances. Label it, upload the empty-room original, and place the original immediately before or after the staged photo.",
  },
  {
    q: "Can I remove a utility pole or a neighbor's house from a CRMLS photo?",
    a: "No. CRMLS prohibits adding any photo altered to add, remove, or modify elements outside of or visible from the property, naming streetlights, utility poles, views through windows, and neighboring properties. The rule states no exception for this category.",
  },
  {
    q: "Can I show a remodel that hasn't happened yet?",
    a: "Only if the listed property will be improved to match the altered photo by close, as part of the listed price. That is the one exception CRMLS gives for altering real-property elements such as flooring, cabinetry, paint color or landscape. Renderings of improvements that won't be in place at closing can go in the listing's Supplements, with a notice that they aren't included in the price.",
  },
  {
    q: "Is sky replacement allowed on CRMLS?",
    a: "The rule doesn't name it. Skies aren't in either prohibited list, but views through windows are, and Rule 11.5(c) requires media to be a truthful representation of the property in all respects. Ask CRMLS compliance before relying on a replaced sky.",
  },
  {
    q: "Where do I type the label?",
    a: "In the text field for the altered photo in the add/edit module. Rule 11.5.2 accepts \"Photo Modified\", \"Virtually Staged\", \"Digitally Altered\" or \"AI Altered\", or an accurate, substantially similar term.",
  },
];

const schema = [
  {
    "@type": "Article",
    headline: h1,
    description,
    mainEntityOfPage: `https://retouchlint.com${path}`,
    author: { "@type": "Organization", name: "RetouchLint" },
    publisher: { "@id": "https://retouchlint.com/#organization" },
  },
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
