      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

const related = [
  { url: "/mls-photo-requirements/", anchor: "All California MLS photo rules compared" },
  { url: "/mls-photo-requirements/mlslistings/", anchor: "MLSListings: no links on listing photos" },
  { url: "/mls-photo-requirements/bay-east/", anchor: "Bay East: original goes immediately after" },
  { url: "/blog/virtual-staging-disclosure-rules/", anchor: "Virtual staging disclosure rules" },
];
---
<ArticleLayout
  title={title}
  h1={h1}
  description={description}
  path={path}
  related={related}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "MLS photo requirements", url: "/mls-photo-requirements/" },
    { name: "CRMLS", url: path },
  ]}
  schema={schema}
>
  <p>
    On CRMLS you can virtually stage a listing photo if you label it and put the unaltered
    original immediately before or after it. You cannot alter landscape, walls, flooring or
    other parts of the property unless the home will be improved to match by close. You
    also cannot alter anything outside or visible from the property, such as power lines,
    streetlights or the view. Those rules took effect with CRMLS's Rules &amp; Policies
    of July 10, 2026, and they are stricter than AB 723.
  </p>

  <h2>What Rule 11.5.2 requires</h2>
  <p>A Subscriber who submits a Digitally Altered Image must also:</p>
  <ol>
    <li>submit the original, unaltered version;</li>
    <li>make sure the original is displayed in the listing immediately before or after the altered image; and</li>
    <li>label the altered image "Photo Modified", "Virtually Staged", "Digitally Altered" or "AI Altered", or an accurate, substantially similar term, in the photo's text field in the add/edit module.</li>
  </ol>

  <h2>CRMLS defines "altered" more narrowly than the statute</h2>
  <p>
    AB 723 treats almost any added, removed or changed element as an alteration: fixtures,
    furniture, flooring, landscape, utility poles and more. CRMLS's definition covers only
    edits "related to furniture or appliances." Both exclude the same routine adjustments:
    lighting, sharpening, white balance, color correction, angle, straightening, cropping
    and exposure.
  </p>
  <p>
    That narrower definition isn't a loosening. CRMLS moved everything else out of the
    "label it" category and into a prohibition.
  </p>

  <h2>The edits CRMLS prohibits</h2>
  <p>
    Citing Rule 11.5.2 together with its truth-in-advertising rules (11.5(c) and 12.10),
    CRMLS says Subscribers may not add a photo altered to add, remove or modify:
  </p>
  <ul>
    <li>
      <strong>Real-property elements</strong>: flooring, walls, windows, structural
      elements, cabinetry, paint color, hardscape, landscape, façade, fixtures or floor
      plans. Allowed only if the listed property will be improved to match the photo by
      close, as part of the listed price.
    </li>
    <li>
      <strong>Elements outside of or visible from the property</strong>: streetlights,
      utility poles, views through windows and neighboring properties. The rule states no
      exception.
    </li>
  </ul>
  <p>
    A label does not cure either one. A photo with a removed utility pole is non-compliant
    on CRMLS however clearly it is marked, and Rule 11.5.3 lets the MLS remove
    non-compliant media without notice.
  </p>

  <h2>Worked examples</h2>
  <h3>Staged bedroom: allowed</h3>
  <p>
    Furniture added to an empty bedroom is the textbook Digitally Altered Image. Type
    "Virtually Staged" in the photo's text field and upload the empty-room original
    directly after it. Off the MLS, on flyers or your own site, the AB 723 statement with a
    link to the original still applies; the <a href="/tools/disclosure-generator/">disclosure
    generator</a> writes it.
  </p>
  <h3>Painted kitchen cabinets for a home sold "as is": not allowed</h3>
  <p>
    Cabinetry and paint color are real-property elements. The seller isn't refinishing the
    cabinets before close, so the exception doesn't apply. Use the unedited photo, and if
    you want to show the possibility, put a rendering in the Supplements with a notice that
    the work isn't included in the price.
  </p>
  <h3>New-build listing with the finished landscaping: allowed</h3>
  <p>
    If the builder is installing that landscaping before close as part of the listed price,
    the exception applies. Rule 11.5(c) allows renderings of conditions that will be in
    place at closing, under the 11.5.2 requirements. Label it and keep it truthful.
  </p>
  <h3>Exterior with the power lines removed: not allowed</h3>
  <p>
    Utility poles are named among the outside elements that may not be altered, with no
    exception. A disclosure doesn't help. Upload the photo with the lines in it.
  </p>

  <h2>Other CRMLS media rules that catch photographers</h2>
  <ul>
    <li><strong>Exterior photo within two days.</strong> Rule 11.5.1 requires at least one photo or rendering of a substantial portion of the exterior within two days of entry, kept in the listing in every status. Business Opportunity listings are exempt, and a seller's written no-photo instruction has to reach the MLS within the same two days.</li>
    <li><strong>No branding.</strong> Rule 11.5(e) bars content that identifies the agent or brokerage, including signs, logos, contact information, identifiable people, external links and team names.</li>
    <li><strong>Off-property views get a caption.</strong> Rule 11.5(c) requires photos of views that aren't of or from the property, and photos of HOA amenities, to be captioned as such.</li>
  </ul>

  <h2>Questions</h2>
  {faq.map((f) => (
